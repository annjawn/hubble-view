{
  "name": "hubble",
  "productName": "Hubble",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hubble — a local usage monitor for AI coding harnesses",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:5173 && electron-vite build --mode development && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc -b && vite build && electron-vite build",
    "backend:bundle": "node scripts/build-backend.mjs",
    "dist:mac": "npm run backend:bundle && npm run build && electron-builder --mac dmg",
    "dist:win": "npm run backend:bundle && npm run build && electron-builder --win nsis",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests",
    "backend:dev": "uv run --project ../backend uvicorn harness_metrics.main:app --reload --host 127.0.0.1 --port 8765",
    "backend:test": "uv run --project ../backend --group dev python -m pytest ../backend/tests"
  },
  "dependencies": {
    "@tanstack/react-query": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "thinking-orbs": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "electron-vite": "latest",
    "postcss": "latest",
    "tailwindcss": "^3.4.17",
    "typescript": "latest",
    "vite": "^7.3.1",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.annjawn.hubble",
    "productName": "Hubble",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "icons/macos/icon_1024.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist/hubble-service",
        "to": "backend"
      }
    ],
    "mac": {
      "icon": "icons/macos/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "icons/windows/icon.ico"
    },
    "dmg": {
      "title": "Hubble ${version}",
      "icon": "icons/macos/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "allowScripts": {
    "electron@44.0.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
